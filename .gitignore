# ============================================
# CCS HUB - .gitignore
# ============================================

# ============================================
# Node.js / Frontend
# ============================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Build outputs
dist/
build/
.vercel/
out/
.next/
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-workspace
*.sublime-project

# Logs
logs/
*.log

# ============================================
# Python / Backend
# ============================================

# Byte-compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual environments
env/
venv/
ENV/
env.bak/
venv.bak/
pythonenv*
.venv/

# Poetry
poetry.lock

# Database
*.db
*.sqlite3
*.sqlite

# Backend build
*.egg-info/
dist/
build/
*.egg

# Alembic
alembic/versions/*.py
!alembic/versions/__init__.py

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.dmypy.json
dmypy.json

# ============================================
# Docker
# ============================================

*.pid
*.seed
*.pid.lock
docker-compose.override.yml
.dockerignore

# ============================================
# Secrets & Certificates
# ============================================

*.pem
*.key
*.crt
*.p12
*.pfx
*.env.secrets
*.secret

# ============================================
# Operating System
# ============================================

.DS_Store
Thumbs.db
*.tmp
*.temp
*.swp
*.swo
*~

# ============================================
# Project Specific
# ============================================

# Local development
.local/
*.local

# Backup files
*.backup
*.bak
*.old

# Database backups
database/backups/*.sql
database/backups/*.dump

# IDE specific
.vscode/
.idea/
*.iml

# Logs
logs/
*.log

# Uploads
media/
uploads/
static/media/
static/uploads/

# Coverage reports
coverage/
.nyc_output/
htmlcov/

# TypeScript
*.tsbuildinfo

# Temporary files
tmp/
temp/